# Exceed Box — every setting, with the consequence of getting it wrong.
# Copy to .env on the server, fill in, keep it mode 600. Never commit it.

# ── required ─────────────────────────────────────────────────────────────────

# The hostname Caddy will obtain a certificate for. An A record must already
# point at this server or the certificate request fails.
EXCEEDBOX_DOMAIN=box.example.com

# Supabase session pooler. NOT db.<ref>.supabase.co — that hostname stopped
# resolving for these projects, and the pooler is the supported path.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The Supabase project URL. The token issuer and the JWKS URL are both derived
# from this, so there is nothing else to set for sign-in to work.
SUPABASE_URL=https://<ref>.supabase.co

# Service key. Used ONLY server-side, for the private media bucket. If this is
# absent the app silently falls back to storing customer business cards on the
# container's own disk, which is lost on the next deploy.
SUPABASE_SECRET_KEY=sb_secret_...

# Who may sign in. Enforced server-side, never left to Supabase configuration.
EXCEEDBOX_ALLOWED_EMAIL_DOMAINS=exceed-re.ae

# Where the public booking page and unsubscribe links live. Without it, emails
# go out with no unsubscribe link, which is both hostile and non-compliant.
EXCEEDBOX_PUBLIC_BASE_URL=https://box.example.com

# Browser origins allowed to call the API. The web app's own address.
EXCEEDBOX_CORS_ORIGINS=https://box.example.com

# ── email: nothing is delivered until this is deliberately switched on ───────
# Leave as dryrun to record what WOULD be sent without sending it. This is the
# guard against a config file being copied to a new host and immediately
# mailing thirty thousand people.
EXCEEDBOX_MAIL_PROVIDER=dryrun
# SENDGRID_API_KEY=SG....
# EXCEEDBOX_MAIL_FROM=info@mail.exceed-re.ae
# EXCEEDBOX_MAIL_FROM_NAME=EXCEED
# EXCEEDBOX_MAIL_REPLY_TO=info@exceed-re.ae

# ── optional providers, all off by default ───────────────────────────────────
# Reading replies. Off means bounces and out-of-office are still filtered, but
# meeting / partnership / budget intent is left for a human.
EXCEEDBOX_AI_PROVIDER=off
# ANTHROPIC_API_KEY=sk-ant-...
# EXCEEDBOX_AI_MODEL=claude-sonnet-5

# Voice memo transcription. Off means memos are recorded and playable.
EXCEEDBOX_TRANSCRIBE_PROVIDER=off
# OPENAI_API_KEY=sk-...

# Device push. Off means alerts appear in the app only.
EXCEEDBOX_PUSH_PROVIDER=off
# EXPO_ACCESS_TOKEN=...

# ── must stay as they are in a deployment ────────────────────────────────────
# The developer token minter. Refused automatically whenever SUPABASE_URL is
# set, blocked again at the proxy, and named here so nobody adds it by hand.
EXCEEDBOX_DEV_AUTH=0
